# --- Auth (required from step 3) ---
# The single shared PIN typed on the /login screen. Change it any time; no redeploy needed
# if you set it in the Vercel dashboard instead of a local .env file.
APP_PIN=2026

# Random 32+ byte secret used to sign the session cookie. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=

# --- Data layer (memory is the default; required from step 2) ---
# "memory": in-process fake store, resets on every restart — perfect for local dev/tests
#           and for trying the app before the Google Sheet is wired up.
# "google": read/write the real Google Sheet named below (required from step 8).
SHEETS_MODE=memory

# --- Google Sheets (required from step 8, only when SHEETS_MODE=google) ---
# The spreadsheet id from its URL: https://docs.google.com/spreadsheets/d/<THIS_PART>/edit
GOOGLE_SHEET_ID=

# From the Google Cloud service account's JSON key file ("client_email" field).
# Share the spreadsheet with this address (Editor access) or the API calls fail with 403.
GOOGLE_SERVICE_ACCOUNT_EMAIL=

# From the same JSON key file ("private_key" field), including the literal \n line breaks.
GOOGLE_SERVICE_ACCOUNT_PRIVATE_KEY=
